NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Só true atrás de proxy confiável (senão o IP do cliente vira forjável).
TRUST_PROXY=false

DATABASE_URL=postgres://fox:fox@localhost:5432/fox
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=gerar-valor-aleatorio-min-16-chars
WHATSAPP_APP_SECRET=app-secret-do-app-meta
WHATSAPP_ACCESS_TOKEN=token-de-acesso-da-waba
WHATSAPP_GRAPH_VERSION=v21.0

# Pseudonimiza o usuário antes de persistir (LGPD).
# Trocar esta chave torna toda a memória já gravada inalcançável.
USER_REF_SECRET=gerar-com-openssl-rand-hex-32

# Autentica as chamadas à API interna de memória.
INTERNAL_API_TOKEN=gerar-com-openssl-rand-hex-24

# IA. Sem a chave, o classificador roda só por regras e o assistente não responde
# pergunta aberta.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-sonnet-5
CLASSIFIER_ENABLED=true

# Prazo de guarda (LGPD). O worker expurga o que passar disto.
MESSAGE_LOG_RETENTION_DAYS=90
INTERACTION_RETENTION_DAYS=180
RETENTION_INTERVAL_HOURS=6

# PersonAI
PERSONAI_MODEL=claude-sonnet-5
# Por quanto tempo a conversa recente fica no Redis (nunca vai para o Postgres).
PERSONAI_SESSION_TTL_SECONDS=3600

# Busca fundamentada para pergunta aberta. Sem a chave, o assistente responde
# apenas com o que o modelo sabe, sem citar fonte.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Redundância de modelo: usa as credenciais AWS padrão do ambiente.
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-5
