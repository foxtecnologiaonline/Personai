{
  "name": "personai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camadas compartilhadas FOX TecnologIA: Gateway WhatsApp/Roteador de Intenção e Serviço de Memória/Contexto.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts all",
    "dev:api": "tsx --env-file-if-exists=.env watch src/index.ts api",
    "dev:worker": "tsx --env-file-if-exists=.env watch src/index.ts worker",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js all",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "tenant": "tsx --env-file-if-exists=.env src/cli/tenant.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "tenant:prod": "node dist/cli/tenant.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/sdk": "^0.71.0",
    "@fastify/rate-limit": "^11.2.0",
    "bullmq": "^5.63.0",
    "fastify": "^5.7.1",
    "ioredis": "^5.9.0",
    "pg": "^8.18.0",
    "pino": "^9.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
